DATABASE_URL=postgresql://sahra:sahra@localhost:5432/sahra
PORT=2567
# Secret used to sign access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# OAuth client IDs (from your Google Cloud / Apple developer accounts)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
# Local development only: enables POST /auth/dev. Never enable in production.
DEV_AUTH=0
# Display name of the app; the brand is not final.
APP_NAME=Sahra
